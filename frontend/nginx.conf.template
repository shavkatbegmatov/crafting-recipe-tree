server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Backend manzili konteyner ishga tushganda BACKEND_ORIGIN dan olinadi
    # (docker-entrypoint.d/20-backend-origin.sh).
    #
    # Sukut qiymati ATAYLAB loyihaga xos nom: `backend` kabi umumiy nom Coolify'ning
    # yassi umumiy tarmog'ida BOSHQA loyihaning konteyneriga hal bo'lib ketishi mumkin
    # (2026-08-22 da aynan shunday bo'lgan: `backend` -> online-jurnal-api). Loyihaga xos
    # nom hal bo'lmasa 502 beradi — bu begona servisga so'rov yuborishdan ko'ra xavfsizroq.
    #
    # `resolver` + `set` nomni ishga tushishda emas, so'rov paytida hal qiladi, shuning
    # uchun backend mavjud bo'lmasa ham konteyner muammosiz ko'tariladi.

    # API proxy
    location /api {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream __BACKEND_ORIGIN__;
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        client_max_body_size 10M;
    }

    # WebSocket proxy (STOMP over WebSocket)
    location /ws {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream __BACKEND_ORIGIN__;
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Yuklangan rasmlar.
    # `^~` MUHIM: usiz quyidagi kengaytma bo'yicha regex blok ustun kelib, /uploads/x.png
    # statik fayl sifatida qidirilardi va 404 qaytarardi (proxy umuman ishlamasdi).
    location ^~ /uploads {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream __BACKEND_ORIGIN__;
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Swagger UI proxy
    location /swagger-ui {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream __BACKEND_ORIGIN__;
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /api-docs {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream __BACKEND_ORIGIN__;
        proxy_pass $upstream;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static asset caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
